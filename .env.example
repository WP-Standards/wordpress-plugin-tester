# ─── Required ──────────────────────────────────────────────────────────
# The plugin under test. Pick ONE of the patterns below.
#
# WordPress.org slug:
PLUGIN_SOURCE=hello-dolly
#
# Git HTTPS URL (default branch):
# PLUGIN_SOURCE=https://github.com/maurotommasi/carousel-pro.git
#
# Git URL pinned to a specific branch (use `#branch` syntax):
# PLUGIN_SOURCE=https://github.com/maurotommasi/carousel-pro.git#main
#
# ZIP archive over HTTP(S):
# PLUGIN_SOURCE=https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip
#
# Local folder (relative to project root, mounted via LOCAL_PLUGINS_ROOT):
# PLUGIN_SOURCE=file:///local/my-plugin


# ─── Optional ──────────────────────────────────────────────────────────

# Folder name inside wp-content/plugins/. Auto-derived from source if blank.
PLUGIN_SLUG=

# Used as the suffix for container names (wordpress-test-<PLUGIN_NAME>-*).
# Falls back to PLUGIN_SLUG, then to "plugin", if not set.
PLUGIN_NAME=

# Local plugins root (only used when PLUGIN_SOURCE starts with file://)
LOCAL_PLUGINS_ROOT=./local-plugins

# Stack versions
WP_VERSION=6.6
PHP_VERSION=8.2
MARIADB_VERSION=11

# Host ports
WP_PORT=8080
PMA_PORT=8081

# Admin user
WP_ADMIN_USER=test
WP_ADMIN_PASS=test
WP_ADMIN_EMAIL=test@plugin-tester.local
WP_SITE_TITLE=Plugin Tester
